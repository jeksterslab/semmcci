```{r}
#| include = FALSE
knitr::opts_chunk$set(
  collapse = TRUE,
  comment = "#>"
)
```

```{r}
#| include = FALSE
set.seed(seed = 42)
```

```{r}
#| message = FALSE
library(package = semmcci)
library(package = lavaan)
```

## Data

```{r}
#| echo = FALSE
n <- 1000
a <- 0.50
b <- 0.50
cp <- 0.25
sigmasqem <- 1 - a^2
sigmasqey <- 1 - cp^2 - a^2 * b^2 - b^2 * (1 - a^2) - 2 * cp * a * b
em <- stats::rnorm(n = n, mean = 0, sd = sqrt(x = sigmasqem))
ey <- stats::rnorm(n = n, mean = 0, sd = sqrt(x = sigmasqey))
X <- stats::rnorm(n = n)
M <- a * X + em
Y <- cp * X + b * M + ey
df <- data.frame(X, M, Y)
```

```{r}
summary(object = df)
colMeans(x = df)
stats::var(x = df)
```

## Model Specification

```{r}
model <- "
  Y ~ cp * X + b * M
  M ~ a * X
  indirect := a * b
  direct := cp
  total := cp + (a * b)
"
```

## Model Fitting

```{r}
fit <- lavaan::sem(data = df, model = model)
```

## Monte Carlo Confidence Intervals

```{r}
unstd <- MC(lav = fit, R = 20000L, alpha = 0.05)
```

## Methods

### print

```{r}
print(x = unstd)
```

### summary

```{r}
summary(object = unstd)
```

### coef

```{r}
stats::coef(object = unstd)
```

### vcov

```{r}
stats::vcov(object = unstd)
```

### confint

```{r}
stats::confint(object = unstd, level = 0.95)
```

## Standardized Monte Carlo Confidence Intervals

```{r}
fit <- lavaan::sem(data = df, model = model, fixed.x = FALSE)
unstd <- MC(lav = fit, R = 20000L, alpha = 0.05)
```

```{r}
std <- MCStd(mc = unstd, alpha = 0.05)
```

## Methods

### print

```{r}
print(x = std)
```

### summary

```{r}
summary(object = std)
```

### coef

```{r}
stats::coef(object = std)
```

### vcov

```{r}
stats::vcov(object = std)
```

### confint

```{r}
stats::confint(object = std, level = 0.95)
```

